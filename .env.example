# ============================================================
# EASY LIVIN GOA — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to git.
# ============================================================

# ── Server ─────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# ── Database ────────────────────────────────────────────────
# Get this from your Railway/Supabase/Neon dashboard
# For development: install PostgreSQL locally and use:
DATABASE_URL=postgresql://postgres:password@localhost:5432/easyliving_dev
# For Supabase/PlanetScale, DIRECT_URL bypasses the connection pooler:
DIRECT_URL=postgresql://postgres:password@localhost:5432/easyliving_dev

# ── JWT (generate strong random secrets) ───────────────────
# Command to generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_HEX_STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS (allowed origins) ──────────────────────────────────
WEB_URL=http://localhost:3000
CRM_URL=http://localhost:3001

# ── Cloudinary (image/video storage) ───────────────────────
# Sign up free at cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=easyliving_properties

# ── Email (SMTP) ────────────────────────────────────────────
# For development, use Mailtrap (free): mailtrap.io
# For production, use Resend (resend.com) or AWS SES
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
EMAIL_FROM=noreply@easylivingoa.com
EMAIL_FROM_NAME=Easy Livin Goa

# ── Seed admin password ─────────────────────────────────────
SEED_ADMIN_PASSWORD=ChangeMe@123!

# ── Phase 2+ (leave blank until ready) ─────────────────────
# WHATSAPP_PROVIDER_API_KEY=
# META_ACCESS_TOKEN=
